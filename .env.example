# Copy this file to .env and fill in the values. .env is gitignored; never commit it.

# --- Cloudflare Tunnel (required only for `docker compose --profile tunnel up`) ---
# Get the token from the Cloudflare Zero Trust dashboard:
#   Networks -> Tunnels -> (create or open a tunnel) -> Configure ->
#   "Install and run a connector"  ->  copy the token (the long string after `--token`).
# Then add a Public Hostname route for the tunnel:
#   qanda-static.opf-labs.org  ->  Service: HTTP  ->  http://web:80
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional ---
# Database image used by the build profile. Override on older hosts: MariaDB 11
# requires a newer kernel than Debian 9 (4.9), where mariadb:10.5 is the newest
# tag that starts.
# QANDA_DB_IMAGE=mariadb:10.5

# Which database dump the build profile loads (defaults to the dated dump in this dir).
# QANDA_DUMP=./qanda-2026-08-17.sql.gz
